{
  "name": "tiffin-mart-online",
  "version": "1.0.0",
  "private": true,
  "description": "Tiffin Mart online pass ordering with Razorpay",
  "main": "server.js",
  "scripts": {
    "start": "node -e \"const fs=require('fs');const p='server.js';let s=fs.readFileSync(p,'utf8');s=s.replace(\\\"app.get('/api/admin/summary',requireAdmin,(req,res)=>\\\",\\\"app.get('/api/admin/summary',(req,res)=>\\\");const old=\\\"notes:{plan:plan.name,duration,customer_name:name,phone}\\\";const neu=\\\"notes:{plan:plan.name,duration,customer_name:name,phone,email:email,address:address,start_date:startDate,note:note}\\\";if(s.includes(old))s=s.replace(old,neu);fs.writeFileSync(p,s);require('./server.js')\"",
    "dev": "node server.js"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "razorpay": "^2.9.6",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.17.2"
  }
}
